# Where the Vite dev server forwards /api (dev only).
VITE_BACKEND_URL=http://localhost:8080

# Leave empty in dev (requests go through the Vite proxy).
# Set only if the built frontend is served from a different origin than the API.
VITE_API_BASE_URL=

# School email domain accepted at registration. The frontend checks it for
# instant feedback; the backend must enforce it too.
VITE_SCHOOL_DOMAIN=cit.edu
